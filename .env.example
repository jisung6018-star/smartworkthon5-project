# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.  (copy .env.example .env)
# .env 는 절대 발표 화면에 띄우거나 공유하지 마세요.

# ── AI (둘 중 하나 이상) ──────────────────────────────
# Claude: https://console.anthropic.com → API Keys (크레딧 충전 필요, $5~)
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey (무료 한도 있음, 음성 받아쓰기 가능)
GEMINI_API_KEY=

# 비우면 있는 키로 자동 선택. 강제하려면 claude 또는 gemini (mock = 키 없이 가짜 응답으로 흐름만 테스트)
LLM_PROVIDER=
# 1 = 같은 입력은 저장된 답 재사용 (시연 안정성). 항상 새로 호출하려면 0
LLM_CACHE=1
# 비용 표시용 환율 가정 (원/달러)
USD_KRW=1400
# 모델 (보통 비워두기)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=
# Claude 안전 거절 시 서버가 다른 모델로 자동 재시도 (1=켜기)
CLAUDE_FALLBACKS=1

# ── 메일 (실제 발송할 때만) ───────────────────────────
MAIL_PROVIDER=gmail
MAIL_USER=
MAIL_PASSWORD=
# 1 이면 실제로 보내지 않고 output/outbox/*.eml 로 저장 (시연 기본값)
MAIL_DRY_RUN=1

# ── 알림 (쓰는 것만) ─────────────────────────────────
SLACK_WEBHOOK=
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
JANDI_WEBHOOK=
